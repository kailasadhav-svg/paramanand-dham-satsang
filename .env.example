ADMIN_PIN=1960
SESSION_SECRET=change-me-in-production
# Set to true only when serving over HTTPS (auto-true on Vercel)
COOKIE_SECURE=false

# Public ajapa URL for WhatsApp deep links. Production VPS:
# APP_PUBLIC_URL=https://satsang.dhyeyapurti.in/ajapa

# Required on Vercel (SQLite files do not persist on serverless).
# Hostinger VPS uses local data/satsang.db — leave TURSO_* unset there.
# Create a free DB at https://turso.tech then:
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=...

# Ajapa WhatsApp — display phone 7030111501 (Team Dhyeyapurti / Turiya Infotech)
# Provider: turiya (BSP REST) or meta (Graph API)
WHATSAPP_PROVIDER=turiya
# Turiya Infotech (app.turiyainfotech.com) — Key header + wabaNumber
TURIYA_API_KEY=
TURIYA_WABA_NUMBER=917030111501
TURIYA_API_BASE=https://app.turiyainfotech.com
# Meta Graph (optional / Dove Soft Cloud) — WABA_ID ≠ phone number
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=ajapa-verify
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
WHATSAPP_DRY_RUN=1
GURU_PHONE=9850120960
# Client-side role detect for local-first ajapa UI
NEXT_PUBLIC_GURU_PHONE=9850120960

# IMPORTANT — जुना Team Dhyeyapurti मतदार बॉट चालू ठेवण्यासाठी:
# Meta मध्ये आधी असलेला webhook URL इथे पेस्ट करा. अजपा न हाताळलेले
# मेसेज (hi, 1–9, …) या URL कडे forward होतात.
# LEGACY_WHATSAPP_WEBHOOK_URL=https://YOUR-OLD-BOT-WEBHOOK-URL

# Software rights (उपस्थिती + अहवाल + सर्व स्क्रीन) — फक्त 9225118811
NEXT_PUBLIC_SOFTWARE_PHONE=9225118811
# चरणसेवक — सॉफ्टवेअर अधिकार नाहीत; फक्त स्वतःचे काम
# 9423078811 कैलास · 9136443333 मधुसुदनदास (चरणसेवक म्हणून)
NEXT_PUBLIC_SEEKER_PHONES=9423078811,9136443333
# Optional LLM (else knowledge-base ≥200 word Marathi answers)
# OPENAI_API_KEY=
# AJAPA_AI_MODEL=gpt-4o-mini
