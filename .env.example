ADMIN_PIN=1960
SESSION_SECRET=change-me-in-production
# Set to true only when serving over HTTPS (auto-true on Vercel)
COOKIE_SECURE=false

# Required on Vercel (SQLite files do not persist on serverless).
# Create a free DB at https://turso.tech then:
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=...

# Ajapa WhatsApp (Meta Cloud API / Dove Soft) — display phone 7030111501
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WABA ID from Meta BM / Dove Soft (NOT the phone number) — needed to submit templates
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=ajapa-verify
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
WHATSAPP_DRY_RUN=1
GURU_PHONE=9850120960
# Optional LLM (else knowledge-base ≥200 word Marathi answers)
# OPENAI_API_KEY=
# AJAPA_AI_MODEL=gpt-4o-mini
