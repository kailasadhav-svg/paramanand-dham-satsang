# Production host: https://satsang.dhyeyapurti.in (nginx / VPS — app and DB on the same server).
# Health: GET /api/health → production_ready needs strong secrets + WhatsApp webhook secrets.
# Preferred VPS store: ALLOW_FILE_STORE=1 with data/satsang.db. Turso only for multi-instance / Vercel.

ADMIN_PIN=
SESSION_SECRET=
COOKIE_SECURE=true
# NEXT_PUBLIC_APP_URL=https://satsang.dhyeyapurti.in
# APP_PUBLIC_URL=https://satsang.dhyeyapurti.in
# ALLOWED_ORIGINS=https://satsang.dhyeyapurti.in

# Preferred production on a single VPS (app + SQLite on the same disk):
ALLOW_FILE_STORE=1
# SQLite file: data/satsang.db (created on first request; persist this path)

# Turso only for multi-instance or Vercel (ephemeral disk). Create a DB at https://turso.tech then:
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=...

# WhatsApp webhook (Meta) — required in production
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# META_APP_SECRET=  # alias for WHATSAPP_APP_SECRET

# Ajapa WhatsApp — display phone 7030111501 (Team Dhyeyapurti / Turiya Infotech)
# Provider: turiya (BSP REST) or meta (Graph API)
WHATSAPP_PROVIDER=meta
# Turiya Infotech (app.turiyainfotech.com) — Key/apikey header + wabaNumber
# Set WHATSAPP_PROVIDER=turiya when using BSP instead of Meta Graph.
TURIYA_API_KEY=
TURIYA_WABA_NUMBER=917030111501
TURIYA_API_BASE=https://app.turiyainfotech.com
# Meta Graph (required for WHATSAPP_PROVIDER=meta) — WABA_ID ≠ phone number
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
# Local/dev only. Production ignores this — never silently fake OTP delivery.
WHATSAPP_DRY_RUN=1
# OTP Utility template ({{1}}=6-digit code). Fallback: ajapa_welcome_code
WHATSAPP_OTP_TEMPLATE=ajapa_app_otp
GURU_PHONE=9850120960
# Client-side role detect for local-first ajapa UI
NEXT_PUBLIC_GURU_PHONE=9850120960
# Software rights (उपस्थिती + अहवाल + सर्व स्क्रीन) — फक्त 9225118811
NEXT_PUBLIC_SOFTWARE_PHONE=9225118811
# चरणसेवक — सॉफ्टवेअर अधिकार नाहीत; फक्त स्वतःचे काम
# 9423078811 कैलास · 9136443333 मधुसुदनदास (चरणसेवक म्हणून)
NEXT_PUBLIC_SEEKER_PHONES=9423078811,9136443333
# Optional LLM (else knowledge-base ≥200 word Marathi answers)
# OPENAI_API_KEY=
# AJAPA_AI_MODEL=gpt-4o-mini
